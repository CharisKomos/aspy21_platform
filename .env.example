# Copy to .env and fill in. .env is git-ignored; this template is not, so never
# put a real password here.
#
#     cp .env.example .env
#     docker compose up -d
#
# Compose reads .env from this directory automatically.

# ---------------------------------------------------------------------------
# mock (default) needs nothing else. Everything below applies to live mode.
# ---------------------------------------------------------------------------
ASPY21_MODE=mock

# The ProcessData REST root. aspy21 appends /SQL and /Browse itself, so give the
# root, not a full endpoint path. If you do not know the path your site exposes,
# the setup wizard (python setup_live.py) probes the usual ones for you.
ASPY21_BASE_URL=https://aspen-hist01/ProcessData

# The IP.21 datasource name — often IP21 or a plant code. Tag search fails
# without it, so an empty tag browse almost always means this is wrong.
ASPY21_DATASOURCE=IP21

# basic | ntlm | negotiate | none
# Try basic first. A 401 usually means the site fronts IP.21 with Windows
# Integrated authentication — switch to ntlm.
ASPY21_AUTH_SCHEME=basic

# NTLM normally wants the domain prefix: DOMAIN\username. A bare username is the
# most common cause of a 401 that looks like a wrong password.
ASPY21_USERNAME=
ASPY21_PASSWORD=

# THE SETTING THAT FAILS SILENTLY.
# IP.21 answers in the historian machine's local wall time with no zone attached.
# Get this wrong and every reading is stored at the wrong time of day — no error,
# no warning, and it flows straight into your control limits.
# Use UTC, local, or an IANA name such as Europe/Athens.
ASPY21_TIMEZONE=UTC

# Certificate handling. Prefer a CA bundle over switching verification off.
ASPY21_VERIFY_SSL=true
ASPY21_CA_BUNDLE=

# Seconds to wait on one historian call.
ASPY21_TIMEOUT=30

# Host port to publish on. Change it if something already holds 8000 — the
# DeMAICo stack runs its own copy on 8001.
ASPY21_PORT=8000

# ---------------------------------------------------------------------------
# SQLplus scripts
# ---------------------------------------------------------------------------
# Folder of .sql files the SQL card lists and runs. Point it anywhere on the
# host; it is mounted read-only into the container, so adding a file and
# refreshing the page is enough — no rebuild.
ASPY21_SQL_DIR=./sql

# aspy21 cannot alter the historian. SQLplus can: with the right permissions it
# will UPDATE and DELETE, and a mistyped WHERE against a production historian is
# not recoverable. Anything that is not a SELECT is refused unless this is true.
# The durable protection is a read-only account on the historian, which no
# setting here can override.
ASPY21_SQL_ALLOW_WRITES=false
